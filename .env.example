# Copiar a .env.local y completar. `.env*` está en .gitignore: no subir este
# archivo con valores reales adentro.

# La cadena de conexión a Postgres.
#
# Sin esta variable la app corre contra el seed en memoria, que es lo que hace
# que un clon recién bajado levante y se vea. Con ella, contra la base.
#
# En Supabase sale de Project Settings → Database → Connection string → URI, y
# conviene la del pooler en modo transaction (puerto 6543): Next abre y cierra
# conexiones seguido y el pooler es el que aguanta eso.
#
#   DATABASE_URL=postgresql://postgres.<ref>:<contraseña>@aws-0-<región>.pooler.supabase.com:6543/postgres
#
# Para un Postgres local:
#
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guardian
DATABASE_URL=
